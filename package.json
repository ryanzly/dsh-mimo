{
  "name": "dsh-mimo",
  "version": "0.1.0",
  "displayName": "MiMo Coding Plan",
  "description": "Xiaomi MiMo Coding Plan / Token Plan provider for DeepSeek Harness: OAuth or API-key sign-in, live model discovery, adaptive reasoning levels, plan-quota pill, MiMo ASR voice input and MiMo TTS voice output.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-client-plugin",
    "mimo",
    "xiaomi",
    "token-plan",
    "coding-plan",
    "llm-provider",
    "asr",
    "tts"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run-all.mjs",
    "check": "node tests/run-all.mjs && node scripts/check-manifest.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanzly/dsh-mimo.git"
  },
  "homepage": "https://github.com/ryanzly/dsh-mimo#readme",
  "bugs": {
    "url": "https://github.com/ryanzly/dsh-mimo/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  }
}
